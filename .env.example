# 当前项目默认不依赖 .env 文件运行。
# 下面仅作为源码运行 / 调试 / 自动化验证时的可选环境变量示例。

# 运行时目录
OTC_APP_RESOURCE_DIR=
OTC_APP_RUNTIME_DIR=
OTC_OUTPUT_DIR=

# 发布构建资源
OTC_RELEASE_SKILL_ROOT=
OTC_RELEASE_FFMPEG_ROOT=

# 素材目录（按需覆盖）
OTC_SPEECH_DIR=
OTC_PRODUCT_DIR=
OTC_SYMPTOM_DIR=
OTC_DRAFT_ROOT=

# 大模型接口（可选）
LLM_API_KEY=
LLM_BASE_URL=https://api.kuai.host/v1
LLM_MODEL=deepseek-v3.2
